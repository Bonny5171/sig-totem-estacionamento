    "@electron-forge/plugin-vite": "^7.11.1",
    "@react-native/assets-registry": "^0.79.7",
    "@tailwindcss/postcss": "^4",
    "@types/electron": "^1.4.38",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-native": "^0.72.8",
    "autoprefixer": "^10.4.23",
