  "description": "SIG Totem Estacionamento",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron-forge start\"",
    "electron:build": "npm run build && electron-forge package",
    "electron:make": "npm run build && electron-forge make",
    "electron:make:win": "npm run build && electron-forge make --platform=win32",
    "electron:make:mac": "npm run build && electron-forge make --platform=darwin",
    "electron:make:linux": "npm run build && electron-forge make --platform=linux"
  },
  "dependencies": {
    "@expo/html-elements": "^0.10.1",
    "@gluestack-ui/core": "^3.0.12",
    "@gluestack-ui/utils": "^3.0.15",
